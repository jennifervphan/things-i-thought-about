---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<style>
  .about-title {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0 0 2rem;
  }
  @media (min-width: 640px) {
    .about-title { font-size: 32px; }
  }
</style>

<BaseLayout title="About — things i thought about">
  <article>
    <h1 class="about-title">About</h1>
    <div class="prose prose-themed max-w-none" style="font-size: 16px; line-height: 1.85;">
      <p>
        Hi, I'm JP. This is where I write about things, sometimes weird, sometimes not, I've been thinking about —
        ideas, observations, and whatever's been on my mind.
      </p>
    </div>
  </article>
</BaseLayout>

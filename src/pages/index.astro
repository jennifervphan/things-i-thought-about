---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = await Astro.glob('../content/posts/*.md');

const sortedPosts = posts
  .map((post) => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    pubDate: new Date(post.frontmatter.pubDate),
    updatedDate: post.frontmatter.updatedDate ? new Date(post.frontmatter.updatedDate) : undefined,
    tags: post.frontmatter.tags ?? [],
    slug: post.file.split('/').pop()?.replace('.md', '') ?? '',
  }))
  .sort((a, b) => {
    const aDate = a.updatedDate ?? a.pubDate;
    const bDate = b.updatedDate ?? b.pubDate;
    return bDate.getTime() - aDate.getTime();
  });
---

<BaseLayout title="things i thought about">
  <div>
    {sortedPosts.map((post) => (
      <PostCard
        title={post.title}
        description={post.description}
        pubDate={post.pubDate}
        updatedDate={post.updatedDate}
        slug={post.slug}
        tags={post.tags}
      />
    ))}
  </div>
</BaseLayout>

---
interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group py-6 border-b border-gray-100 last:border-0">
  <a href={`/posts/${slug}`} class="block">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-medium group-hover:text-gray-500 transition-colors mb-1">
          {title}
        </h2>
        {description && (
          <p class="text-sm text-gray-500 leading-relaxed">{description}</p>
        )}
        {tags.length > 0 && (
          <div class="flex gap-2 mt-2">
            {tags.map((tag) => (
              <span class="bg-gray-100 text-gray-500 px-2 py-0.5 rounded text-xs">{tag}</span>
            ))}
          </div>
        )}
      </div>
      <time class="text-sm text-gray-400 whitespace-nowrap shrink-0" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
    </div>
  </a>
</article>
